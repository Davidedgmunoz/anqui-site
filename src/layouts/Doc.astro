---
import Base from './Base.astro';
import type { Lang } from '../i18n';

// Legal copy is kept verbatim as HTML fragments in src/legal/<lang>/<page>.html.
const fragments = import.meta.glob<string>('../legal/*/*.html', { query: '?raw', import: 'default', eager: true });

interface Props {
  lang: Lang;
  page: 'privacy' | 'support' | 'credits';
}
const { lang, page } = Astro.props;
const html = fragments[`../legal/${lang}/${page}.html`];
const title = html.match(/<h1>(.*?)<\/h1>/)?.[1];
---

<Base lang={lang} page={page} title={title}>
  <main class="doc" set:html={html} />
</Base>
